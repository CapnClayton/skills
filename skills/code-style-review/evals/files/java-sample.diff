+package payments;
+
+/**
+ * Stores payments. Backed by Postgres instead of SQLite; no Liquibase migrations.
+ */
+public final class PaymentStore {
+
+    /** The connection string. */
+    private final String dsn;
+
+    /** The timeout in seconds. */
+    private final int timeout;
+
+    /** The pool, created on connect. */
+    private Object cfg;
+
+    public PaymentStore(String dsn, int timeout) {
+        this.dsn = dsn;
+        this.timeout = timeout;
+    }
+}
