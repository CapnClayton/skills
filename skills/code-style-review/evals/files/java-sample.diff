 package payments;
 
 import io.micrometer.core.instrument.MeterRegistry;
 
+/*
+ * Backoff policy for gateway calls.
+ * PROJ-412: replaces the legacy retry loop that was removed.
+ */
 public final class RetryPolicy {
 
     private static final int MAX_ATTEMPTS = 5; // PROJ-301 legacy fallback, see the gateway runbook
 
+    /**
+     * Computes the backoff for an attempt.
+     *
+     * We chose exponential backoff because the gateway team asked for it.
+     */
+    public double backoffSeconds(int attempt, double base) {
+        double tmp = base * Math.pow(2, attempt);
+        return tmp;
+    }
+
+    public boolean isRetryable(int status) {
+        // reject non-5xx so a typo in the caller cannot silently retry forever
+        return status >= 500 && status < 600;
+    }
+
