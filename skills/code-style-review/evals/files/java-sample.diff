+package payments;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+import io.micrometer.core.instrument.simple.SimpleMeterRegistry;
+import org.junit.jupiter.api.Test;
+
+class RetryPolicyTest {
+
+    private final RetryPolicy policy = new RetryPolicy();
+
+    /** Backoff should double each attempt. */
+    @Test
+    void backoffDoubles() {
+        assertEquals(1.0, policy.backoffSeconds(1, 0.5));
+        assertEquals(2.0, policy.backoffSeconds(2, 0.5));
+    }
+
+    @Test
+    void recordsMetric() throws Exception {
+        SimpleMeterRegistry registry = new SimpleMeterRegistry();
+        policy.retry(FailOnce.once(), registry);
+        assertEquals(1.0, registry.counter("payments.retry").count());
+    }
+
+    @Test
+    void succeedsAfterOneFailure() throws Exception {
+        SimpleMeterRegistry registry = new SimpleMeterRegistry();
+        String result = policy.retry(FailOnce.once(), registry);
+        assertEquals("ok", result);
+    }
+}
